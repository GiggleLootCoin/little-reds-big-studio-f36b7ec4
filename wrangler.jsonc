{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-reds-big-studio-f36b7ec4",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "preview_urls": true,
}
